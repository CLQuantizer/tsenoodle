{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tsenoodle",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_flags": ["nodejs_compat"],
	"compatibility_date": "2024-10-22",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	},
	"ai": {
		"binding": "AI"
	}
}
